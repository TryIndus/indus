{
	"name": "indus",
	"version": "0.1.0",
	"private": true,
	"packageManager": "bun@1.3.13",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"test:static": "bun run lint && bun run typecheck && bun run build",
		"test:unit": "vitest run __tests__/lib __tests__/middleware",
		"test:unit:coverage": "vitest run --coverage __tests__/lib __tests__/middleware",
		"db:start": "supabase start",
		"db:start:test": "supabase start -x gotrue,realtime,storage-api,imgproxy,kong,mailpit,postgrest,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
		"db:stop": "supabase stop --no-backup",
		"db:reset": "supabase db reset --local",
		"test:database": "bash scripts/test-database.sh",
		"test:integration": "playwright test --grep @integration --project=chromium",
		"test:browser": "bun run build && E2E_USE_PRODUCTION=true playwright test --grep @browser",
		"test:browser:run": "E2E_USE_PRODUCTION=true playwright test --grep @browser",
		"test:accessibility": "playwright test --grep @accessibility --project=chromium",
		"test:authenticated": "bash scripts/test-authenticated.sh",
		"test:performance": "bun run build && E2E_USE_PRODUCTION=true playwright test --grep @performance --project=chromium",
		"test:performance:run": "E2E_USE_PRODUCTION=true playwright test --grep @performance --project=chromium",
		"test:local": "bash scripts/verify-local.sh",
		"test:phase2": "bash scripts/verify-phase2.sh",
		"test:market-data": "bash scripts/verify-market-data.sh",
		"test:phase3": "bash scripts/verify-phase3.sh",
		"test:phase4": "bash scripts/validate-phase4.sh"
	},
	"dependencies": {
		"@alpacahq/alpaca-trade-api": "4.0.1",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-hover-card": "^1.1.15",
		"@radix-ui/react-icons": "^1.3.2",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slider": "^1.3.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@supabase/ssr": "^0.6.1",
		"@supabase/supabase-js": "2.110.8",
		"@tanstack/react-query": "^5.100.10",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"lightweight-charts": "^5.2.0",
		"lucide-react": "^0.525.0",
		"next": "15.5.22",
		"next-themes": "^0.4.6",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tailwind-merge": "^3.5.0",
		"yahoo-finance2": "^3.14.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.13"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.12.1",
		"@biomejs/biome": "^2.4.14",
		"@playwright/test": "1.62.0",
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "^20.19.39",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "3.2.7",
		"supabase": "2.109.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "7.3.6",
		"vitest": "3.2.7"
	},
	"overrides": {
		"nanoid": "3.3.18",
		"postcss": "8.5.23",
		"sharp": "0.35.3",
		"vite": "7.3.6"
	}
}
